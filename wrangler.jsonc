{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "portfolio",
  "compatibility_date": "2026-09-01",
  "workers_dev": true,
  "routes": [
    {
      "pattern": "adhamabdelwahab.com",
      "custom_domain": true
    },
    {
      "pattern": "www.adhamabdelwahab.com",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./out",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  },
  "observability": {
    "enabled": true
  }
}
